/* Dark theme. */

/* Light theme. */
configuration {
    
	modes: "drun,filebrowser,run";
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      show-hidden: true;
      sorting-method:    "name";
      command: "xdg-open";
  }
}


window {
    background-color: #0d2013;
    location: center;
    anchor:   center;
    transparency: "real";
    padding: 10px;
    border:  0px;
    border-radius: 10px;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;
}
mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}
message {
    border:  0px 2px 2px 2px;
    border-color: #c2c7c4 ;
//    border-radius: 10px;
    padding: 5;
    background-color: #9175B9;
}
message {
    font: "Source Code Pro 8";
    color: #000000;
}
inputbar {
    color: #981650;
    background-color:#0d3013;
    border-color: #2D5997;
    padding: 11px;
    border: 2px 2px 2px 2px;
    border-radius:  15px 15px 0px 0px;
    font: "Source Code Pro 18";
}
entry,prompt,case-indicator {
    text-font: inherit;
    text-color:inherit;
}
prompt {
    margin:     0px 0.3em 0em 0em ;
}
listview {
    background-color:#0d2013;
    border-color: #2D5997;
    padding: 8px;
    border-radius: 0px 0px 15px 15px;
    border: 0px 2px 2px 2px;
    dynamic: false;
    lines: 10;
}
element {
    padding: 3px;
    vertical-align: 0.5;
//    border: 2px;
    border-radius: 4px;
    background-color:transparent;
    color:#00ffff;
    font:inherit;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element selected.normal {
    background-color: #5C60A0;
}
element normal active {
    foreground: #5273C5;
}
element normal urgent {
    foreground: #981650;
}
element alternate normal {
    foreground: green;
}
element alternate active {
    foreground:#5273C5;
}
element alternate urgent {
    foreground: #981650;
}
element selected active {
    background-color: #5273C5;
    foreground:#5d7163;
}
element selected urgent {
    background-color: #981650;
    foreground:#5d7163;
}
element normal normal {

}
vertb {
    expand: false;
    children: [ dummy0, mode-switcher, dummy1  ];
}
dummy0,  dummy1 {
    expand: true;
}
mode-switcher {
    expand: false;
    orientation: vertical;
    spacing: 0px;
    border: 0px 0px 0px 0px;
}
button {
    font: "FontAwesome 22";
    padding: 6px;
    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    horizontal-align: 0.5;
}
button selected normal {
    border: 2px 0px 2px 2px;
}
error-message {
    expand: true;
    border: 2px;
    padding: 1em;
}


